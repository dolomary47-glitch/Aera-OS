{
  "_meta": {
    "name": "Aera OS Design Token System",
    "version": "1.2.0",
    "phase": "Week 4",
    "description": "Canonical source of truth for all Aera OS visual tokens. Do not redefine these values inside individual extensions."
  },

  "colors": {
    "accent": {
      "primary":    "#03DFF8",
      "on-primary": "#061316",
      "hover":      "#33E8FA",
      "pressed":    "#02B8D0",
      "muted":      "rgba(3, 223, 248, 0.20)",
      "glow":       "rgba(3, 223, 248, 0.35)"
    },

    "light": {
      "surface": {
        "root":       "rgba(240, 243, 246, 0.92)",
        "strong":     "rgba(255, 255, 255, 0.95)",
        "subtle":     "rgba(255, 255, 255, 0.70)",
        "inner":      "rgba(255, 255, 255, 0.60)",
        "card":       "rgba(255, 255, 255, 0.75)"
      },
      "border": {
        "glass":      "rgba(255, 255, 255, 0.80)",
        "subtle":     "rgba(0, 0, 0, 0.08)"
      },
      "text": {
        "primary":    "#111827",
        "secondary":  "#4B5563",
        "muted":      "#9CA3AF",
        "disabled":   "rgba(17, 24, 39, 0.35)",
        "on-dark":    "#FFFFFF"
      }
    },

    "dark": {
      "surface": {
        "root":       "rgba(18, 22, 30, 0.88)",
        "strong":     "rgba(24, 29, 39, 0.94)",
        "subtle":     "rgba(255, 255, 255, 0.08)",
        "inner":      "rgba(255, 255, 255, 0.06)",
        "card":       "rgba(255, 255, 255, 0.08)"
      },
      "border": {
        "glass":      "rgba(255, 255, 255, 0.16)",
        "subtle":     "rgba(255, 255, 255, 0.08)"
      },
      "text": {
        "primary":    "#FFFFFF",
        "secondary":  "#C6CBD3",
        "muted":      "#8E95A2",
        "disabled":   "rgba(255, 255, 255, 0.35)",
        "on-dark":    "#FFFFFF"
      }
    }
  },

  "typography": {
    "family": {
      "system": "Inter, 'SF Pro Display', 'Cantarell', 'Ubuntu', sans-serif",
      "note": "Use a font actually available in the GNOME environment. Cantarell/Ubuntu is the default fallback."
    },
    "scale": {
      "display": { "size": "80px",  "weight": "700", "usage": "Clock face, hero numbers" },
      "metric":  { "size": "20px",  "weight": "600", "usage": "Important values, subtitles" },
      "label":   { "size": "13px",  "weight": "600", "usage": "Labels, controls" },
      "caption": { "size": "11px",  "weight": "500", "usage": "Dates, metadata" }
    }
  },

  "spacing": {
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "5":  "20px",
    "6":  "24px",
    "8":  "32px",
    "10": "40px"
  },

  "radius": {
    "sm":   "8px",
    "md":   "12px",
    "lg":   "16px",
    "xl":   "20px",
    "2xl":  "24px",
    "pill": "999px"
  },

  "borders": {
    "width": {
      "hairline": "1px"
    },
    "glass": {
      "light": "rgba(255, 255, 255, 0.80)",
      "dark":  "rgba(255, 255, 255, 0.16)"
    }
  },

  "shadows": {
    "floating": "0 14px 36px rgba(0, 0, 0, 0.22)",
    "subtle":   "0 4px 14px rgba(0, 0, 0, 0.08)"
  },

  "glass": {
    "light": {
      "background": "rgba(240, 243, 246, 0.92)",
      "border":     "rgba(255, 255, 255, 0.80)"
    },
    "dark": {
      "background": "rgba(18, 22, 30, 0.88)",
      "border":     "rgba(255, 255, 255, 0.16)"
    },
    "inner": {
      "light": "rgba(255, 255, 255, 0.60)",
      "dark":  "rgba(255, 255, 255, 0.06)"
    },
    "blur": {
      "intention_px": 25,
      "note": "backdrop-filter is not supported in GNOME Shell CSS. Shell blur is supported natively on modern Wayland compositors."
    }
  },

  "states": {
    "hover": {
      "surface_boost": "rgba(255, 255, 255, 0.10)"
    },
    "focus": {
      "color": "#03DFF8",
      "outline": "2px solid #03DFF8"
    },
    "active": {
      "color": "#03DFF8"
    },
    "disabled": {
      "opacity": "0.40"
    }
  },

  "motion": {
    "durations": {
      "fast": "150ms",
      "normal": "250ms",
      "smooth": "350ms",
      "note": "Mirrors theme/src motion durations so extensions and the shell theme animate at the same speed"
    },
    "principles": {
      "panel":   "fade + slide",
      "dock":    "subtle scale on hover",
      "sliders": "smooth value transition"
    }
  },

  "components": {
    "dock":    { "height": "56px" },
    "slider":  { "height": "28px" },
    "compact": { "height": "38px" },
    "widget":  { "width": "240px" },
    "system":  { "width": "300px" }
  }
}
