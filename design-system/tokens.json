{
  "_meta": {
    "name": "Aera OS Design Token System",
    "version": "1.0.0",
    "phase": "Week 2",
    "description": "Canonical source of truth for all Aera OS visual tokens. Do not redefine these values inside individual extensions."
  },

  "colors": {
    "accent": {
      "primary":    "#03DFF8",
      "on-primary": "#061316",
      "hover":      "#33E8FA",
      "pressed":    "#02B8D0",
      "muted":      "rgba(3, 223, 248, 0.20)",
      "glow":       "rgba(3, 223, 248, 0.35)"
    },

    "light": {
      "surface": {
        "root":   "rgba(255, 255, 255, 0.35)",
        "strong": "rgba(255, 255, 255, 0.45)",
        "subtle": "rgba(255, 255, 255, 0.20)",
        "inner":  "rgba(255, 255, 255, 0.15)"
      },
      "border": {
        "glass":  "rgba(255, 255, 255, 0.40)",
        "subtle": "rgba(255, 255, 255, 0.25)"
      },
      "text": {
        "primary":   "#FFFFFF",
        "secondary": "rgba(255, 255, 255, 0.72)",
        "muted":     "rgba(255, 255, 255, 0.55)",
        "disabled":  "rgba(255, 255, 255, 0.40)"
      }
    },

    "dark": {
      "surface": {
        "root":   "rgba(20, 25, 35, 0.70)",
        "strong": "rgba(20, 25, 35, 0.82)",
        "subtle": "rgba(20, 25, 35, 0.55)",
        "inner":  "rgba(255, 255, 255, 0.08)"
      },
      "border": {
        "glass":  "rgba(255, 255, 255, 0.20)",
        "subtle": "rgba(255, 255, 255, 0.12)"
      },
      "text": {
        "primary":   "#FFFFFF",
        "secondary": "#C6CBD3",
        "muted":     "#9E9E9E",
        "disabled":  "rgba(255, 255, 255, 0.40)"
      }
    }
  },

  "typography": {
    "family": {
      "system": "Inter, 'SF Pro Display', 'Cantarell', 'Helvetica Neue', sans-serif",
      "note": "Use a font actually available in the GNOME environment. Cantarell is the GNOME default fallback."
    },
    "scale": {
      "display": { "size": "80px",  "weight": "700", "usage": "Clock face, hero numbers" },
      "metric":  { "size": "20px",  "weight": "600", "usage": "Important values, subtitles" },
      "label":   { "size": "13px",  "weight": "500", "usage": "Labels, controls" },
      "caption": { "size": "11px",  "weight": "400", "usage": "Dates, metadata" }
    }
  },

  "spacing": {
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "5":  "20px",
    "6":  "24px",
    "8":  "32px",
    "10": "40px"
  },

  "radius": {
    "sm":   "8px",
    "md":   "12px",
    "lg":   "16px",
    "xl":   "20px",
    "2xl":  "24px",
    "pill": "999px"
  },

  "borders": {
    "width": {
      "hairline": "1px"
    },
    "glass": {
      "light": "rgba(255, 255, 255, 0.40)",
      "dark":  "rgba(255, 255, 255, 0.20)"
    }
  },

  "shadows": {
    "floating": "0 12px 32px rgba(0, 0, 0, 0.25)",
    "subtle":   "0 6px 18px rgba(0, 0, 0, 0.16)"
  },

  "glass": {
    "light": {
      "background": "rgba(255, 255, 255, 0.35)",
      "border":     "rgba(255, 255, 255, 0.40)"
    },
    "dark": {
      "background": "rgba(20, 25, 35, 0.70)",
      "border":     "rgba(255, 255, 255, 0.20)"
    },
    "inner": {
      "light": "rgba(255, 255, 255, 0.20)",
      "dark":  "rgba(255, 255, 255, 0.10)"
    },
    "blur": {
      "intention_px": 25,
      "note": "backdrop-filter is not supported in GNOME Shell CSS. Use Shell.BlurEffect in GJS with mode=BACKGROUND and radius=25."
    },
    "saturation": {
      "intention_pct": 180,
      "note": "CSS filter:saturate() is not supported in GNOME Shell CSS. Not currently implementable; reserved for future GTK4 surfaces."
    }
  },

  "states": {
    "hover": {
      "surface_boost": "rgba(255, 255, 255, 0.10)",
      "note": "Add ~10% white presence on top of normal surface"
    },
    "focus": {
      "color": "#03DFF8",
      "outline": "2px solid #03DFF8"
    },
    "active": {
      "color": "#03DFF8"
    },
    "disabled": {
      "opacity": "0.40"
    }
  },

  "motion": {
    "note": "Exact durations will be standardized after first real component observation.",
    "principles": {
      "panel":   "fade + slide",
      "dock":    "subtle scale on hover",
      "sliders": "smooth value transition"
    }
  },

  "components": {
    "dock":    { "height": "56px" },
    "slider":  { "height": "30px" },
    "compact": { "height": "38px" }
  }
}
